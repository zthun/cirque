{
  "extends": [
    "@zthun/janitor-ts-config/base.json",
    "@zthun/janitor-ts-config/browser.json",
    "@zthun/janitor-ts-config/react.json"
  ],
  "compilerOptions": {
    "baseUrl": "packages",
    "paths": {
      "@zthun/cirque": ["cirque/src/index.mts"],
      "@zthun/cirque-du-dom": ["cirque-du-dom/src/index.mts"],
      "@zthun/cirque-du-react": ["cirque-du-react/src/index.mts"],
      "@zthun/cirque-du-selenium": ["cirque-du-selenium/src/index.mts"]
    }
  },
  "include": ["**/*.ts", "**/*.tsx", "**/*.mts"],
  "exclude": ["**/node_modules/**", "**/dist/**"]
}
