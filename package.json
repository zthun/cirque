{
  "name": "@zthun/circus",
  "version": "0.0.0",
  "description": "Welcome to the show. We hope you enjoy your stay.",
  "author": "Anthony Bonta",
  "license": "MIT",
  "private": true,
  "type": "module",
  "repository": {
    "type": "git",
    "url": "https://github.com/zthun/cirque"
  },
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "clean": "rimraf --glob 'dist' 'reports' '*.tgz' '*.log' 'packages/**/dist' 'packages/**/*.tgz' 'packages/**/*.log'",
    "test": "vitest --run --coverage",
    "e2e": "cucumber-js",
    "lint": "janitor-lint",
    "check": "tsc --noEmit",
    "build": "lerna run build",
    "make": "yarn clean && yarn lint && yarn check && yarn test && yarn build",
    "postinstall": "husky install"
  },
  "devDependencies": {
    "@commitlint/cli": "^20.2.0",
    "@commitlint/config-conventional": "^20.2.0",
    "@cucumber/cucumber": "^12.4.0",
    "@types/lodash-es": "^4.17.12",
    "@types/node": "^25.0.2",
    "@types/react": "^19.2.7",
    "@types/selenium-webdriver": "^4.35.4",
    "@vitejs/plugin-react": "^5.1.2",
    "@vitest/coverage-v8": "^4.0.15",
    "@zthun/janitor-build-config": "^19.5.3",
    "@zthun/janitor-lint": "^19.5.3",
    "@zthun/janitor-lint-config": "^19.5.3",
    "@zthun/janitor-options": "^19.5.3",
    "happy-dom": "^20.0.11",
    "husky": "^9.1.7",
    "lerna": "^9.0.3",
    "less": "^4.4.2",
    "react": "^19.2.3",
    "react-dom": "^19.2.3",
    "rimraf": "^6.1.2",
    "tsx": "^4.21.0",
    "typescript": "~5.9.3",
    "vite": "^7.2.7",
    "vitest": "^4.0.15"
  },
  "packageManager": "yarn@4.12.0"
}
