{
  "name": "@zthun/circus",
  "version": "0.0.0",
  "description": "Welcome to the show. We hope you enjoy your stay.",
  "author": "Anthony Bonta",
  "license": "MIT",
  "private": true,
  "type": "module",
  "repository": {
    "type": "git",
    "url": "https://github.com/zthun/cirque"
  },
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "clean": "rimraf --glob 'dist' 'reports' '*.tgz' '*.log' 'packages/**/dist' 'packages/**/*.tgz' 'packages/**/*.log'",
    "test": "vitest --run --coverage",
    "e2e": "cucumber-js",
    "lint": "eslint",
    "check": "tsc --noEmit",
    "build": "lerna run build",
    "make": "yarn clean && yarn lint && yarn check && yarn test && yarn build"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.3",
    "@commitlint/config-angular": "^21.2.3",
    "@cucumber/cucumber": "^13.2.1",
    "@types/lodash-es": "^4.17.12",
    "@types/node": "^26.6.3",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/selenium-webdriver": "^4.35.7",
    "@vitest/coverage-v8": "^5.0.3",
    "@zthun/janitor-build-config": "^21.2.4",
    "@zthun/janitor-eslint-config": "^21.2.4",
    "@zthun/janitor-ts-config": "^21.1.3",
    "@zthun/janitor-vite": "^21.2.3",
    "eslint": "^10.11.0",
    "happy-dom": "^20.14.5",
    "husky": "^9.1.7",
    "lerna": "^10.0.1",
    "less": "^4.9.1",
    "prettier": "^3.9.9",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "rimraf": "^6.1.3",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "vite": "^8.3.1",
    "vitest": "^5.0.3"
  },
  "packageManager": "yarn@4.18.1"
}
