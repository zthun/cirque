{
  "name": "@zthun/circus",
  "version": "0.0.0",
  "description": "Welcome to the show. We hope you enjoy your stay.",
  "author": "Anthony Bonta",
  "license": "MIT",
  "private": true,
  "type": "module",
  "repository": {
    "type": "git",
    "url": "https://github.com/zthun/cirque"
  },
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "clean": "rimraf --glob 'dist' 'reports' '*.tgz' '*.log' 'packages/**/dist' 'packages/**/*.tgz' 'packages/**/*.log'",
    "test": "vitest --run --coverage",
    "e2e": "cucumber-js",
    "lint": "eslint",
    "check": "tsc --noEmit",
    "build": "lerna run build",
    "make": "yarn clean && yarn lint && yarn check && yarn test && yarn build",
    "postinstall": "husky install"
  },
  "devDependencies": {
    "@commitlint/cli": "^20.5.0",
    "@commitlint/config-conventional": "^20.5.0",
    "@cucumber/cucumber": "^12.7.0",
    "@types/lodash-es": "^4.17.12",
    "@types/node": "^25.5.0",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@types/selenium-webdriver": "^4.35.5",
    "@vitest/coverage-v8": "^4.1.2",
    "@zthun/janitor-build-config": "^20.0.2",
    "@zthun/janitor-eslint-config": "^20.0.2",
    "@zthun/janitor-ts-config": "^20.0.0",
    "eslint": "^9.39.4",
    "happy-dom": "^20.8.9",
    "husky": "^9.1.7",
    "lerna": "^9.0.7",
    "less": "^4.6.4",
    "prettier": "^3.8.1",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "rimraf": "^6.1.3",
    "tsx": "^4.21.0",
    "typescript": "~5.9.3",
    "vite": "^8.0.3",
    "vitest": "^4.1.2"
  },
  "packageManager": "yarn@4.12.0"
}
