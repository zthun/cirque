{
  "name": "@zthun/circus",
  "version": "0.0.0",
  "description": "Welcome to the show. We hope you enjoy your stay.",
  "author": "Anthony Bonta",
  "license": "MIT",
  "private": true,
  "type": "module",
  "repository": {
    "type": "git",
    "url": "https://github.com/zthun/cirque"
  },
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "clean": "rimraf --glob 'dist' 'reports' '*.tgz' '*.log' 'packages/**/dist' 'packages/**/*.tgz' 'packages/**/*.log'",
    "test": "vitest --run --coverage",
    "e2e": "cucumber-js",
    "lint": "janitor-lint",
    "check": "tsc --noEmit",
    "build": "lerna run build",
    "make": "yarn clean && yarn lint && yarn check && yarn test && yarn build",
    "postinstall": "husky install"
  },
  "devDependencies": {
    "@commitlint/cli": "^19.8.1",
    "@commitlint/config-conventional": "^19.8.1",
    "@cucumber/cucumber": "^11.3.0",
    "@originjs/vite-plugin-global-style": "^1.0.3",
    "@types/lodash-es": "^4.17.12",
    "@types/node": "^24.0.3",
    "@types/react": "^19.1.8",
    "@types/selenium-webdriver": "^4.1.28",
    "@vitejs/plugin-react": "^4.5.2",
    "@vitest/coverage-v8": "^3.2.4",
    "@zthun/janitor-build-config": "^19.2.4",
    "@zthun/janitor-lint": "^19.2.4",
    "@zthun/janitor-lint-config": "^19.2.4",
    "@zthun/janitor-options": "^19.2.4",
    "happy-dom": "^18.0.1",
    "husky": "^9.1.7",
    "lerna": "^8.2.2",
    "less": "^4.3.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "rimraf": "^6.0.1",
    "tsx": "^4.20.3",
    "typescript": "~5.8.3",
    "vite": "^6.3.5",
    "vite-plugin-dts": "^4.5.4",
    "vite-plugin-external": "^6.2.2",
    "vite-plugin-externalize-deps": "^0.9.0",
    "vite-tsconfig-paths": "^5.1.4",
    "vitest": "^3.2.4"
  },
  "resolutions": {
    "rollup": "npm:@rollup/wasm-node@*",
    "vite": "^6.0.0"
  },
  "packageManager": "yarn@4.9.2"
}
