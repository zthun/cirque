{
  "name": "@zthun/circus",
  "version": "0.0.0",
  "description": "Welcome to the show. We hope you enjoy your stay.",
  "author": "Anthony Bonta",
  "license": "MIT",
  "private": true,
  "type": "module",
  "repository": {
    "type": "git",
    "url": "https://github.com/zthun/cirque"
  },
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "clean": "rimraf --glob 'dist' 'reports' '*.tgz' '*.log' 'packages/**/dist' 'packages/**/*.tgz' 'packages/**/*.log'",
    "test": "vitest --run --coverage",
    "e2e": "cucumber-js",
    "lint": "janitor-lint",
    "check": "tsc --noEmit",
    "build": "lerna run build",
    "make": "yarn clean && yarn lint && yarn check && yarn test && yarn build",
    "postinstall": "husky install"
  },
  "devDependencies": {
    "@commitlint/cli": "^19.8.1",
    "@commitlint/config-conventional": "^19.8.1",
    "@cucumber/cucumber": "^12.2.0",
    "@types/lodash-es": "^4.17.12",
    "@types/node": "^24.3.1",
    "@types/react": "^19.1.12",
    "@types/selenium-webdriver": "^4.1.28",
    "@vitejs/plugin-react": "^5.0.2",
    "@vitest/coverage-v8": "^3.2.4",
    "@zthun/janitor-build-config": "^19.3.4",
    "@zthun/janitor-lint": "^19.3.4",
    "@zthun/janitor-lint-config": "^19.3.4",
    "@zthun/janitor-options": "^19.3.4",
    "happy-dom": "^18.0.1",
    "husky": "^9.1.7",
    "lerna": "^8.2.4",
    "less": "^4.4.1",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "rimraf": "^6.0.1",
    "tsx": "^4.20.5",
    "typescript": "~5.9.2",
    "vite": "^7.1.5",
    "vitest": "^3.2.4"
  },
  "packageManager": "yarn@4.9.2"
}
